# Copie este ficheiro para `.env` e preencha com os valores reais.
# O `.env` real está no .gitignore e NUNCA deve ser commitado.

# Ligação à base de dados PostgreSQL
DATABASE_URL=postgresql://utilizador:password@localhost:5432/document_viewer

# Segredo das sessões (string aleatória longa). Obrigatório em produção.
SESSION_SECRET=alterar-para-uma-string-aleatoria-longa

# URL pública da aplicação
APP_URL=http://localhost:3000

# Chave para cifrar os segredos de 2FA (TOTP) na base de dados
TOTP_ENCRYPTION_KEY=alterar-para-uma-chave-aleatoria

# Origens permitidas para CORS (separadas por vírgula). Opcional.
# ALLOWED_ORIGINS=https://o-teu-dominio.com

# Admin inicial (usado apenas quando a tabela de utilizadores está vazia)
# ADMIN_EMAIL=admin@rhulany.mz
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrador

# Atalho de desenvolvimento: entrar sem credenciais (NUNCA em produção)
# DEV_AUTOLOGIN=true
